  "license": "MIT",
  "scripts": {
    "test": "nx run-many --target test",
    "test:unit": "nx run-many --target=test:unit",
    "test:coverage": "vitest run --coverage --project unit",
    "test:acc": "nx run-many --target=test:acc",
    "test:int": "nx run-many --target=test:int",
    "test:scripts": "vitest run --project scripts",
    "lint": "nx run-many --target lint",
    "sam:build:affected": "nx affected -t sam:build",
    "sam:build:all": "nx run-many -t sam:build",
    "sam:deploy:affected": "nx affected -t sam:deploy",
    "sam:deploy:all": "nx run-many -t sam:deploy",
    "sam:validate:affected": "node ./scripts/samValidate.js --projects=affected",
    "sam:validate:all": "node ./scripts/samValidate.js --projects=all",
    "commit": "cz commit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tsc:build": "tsc --build"
  },
  "private": true,
